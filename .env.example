# ==============================================================================
# RECONSTRUCTA — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or set in cloud environment variables before deploying.
#
# PRIVACY & SECURITY DIRECTIVE:
# RECONSTRUCTA operates on an ephemeral architecture. All uploads, working files,
# and exported assets in temporary cloud storage are automatically purged after 2 hours.
# No raw document text, OCR results, or credentials may be logged.
# ==============================================================================

# --- Cloudflare R2 Temporary Storage (S3-Compatible) ---
# Temporary binary storage partitioned strictly under:
#   /uploads/   - User uploads awaiting processing
#   /working/   - Inpainting masks and intermediate working layers
#   /exports/   - Generated downloadable outputs
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=reconstructa-ephemeral
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# --- MongoDB Atlas Metadata Layer ---
# Stores project metadata, session states, and audit logs.
# NO BINARIES OR SENSITIVE DOCUMENT CONTENTS ARE SAVED IN MONGODB.
# An explicit TTL index purges documents after expires_at (2 hours).
MONGODB_URI=mongodb+srv://reconstructa_user:your_secure_password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=reconstructa_production

# --- Ephemeral Lifecycle & Retention Policy ---
RETENTION_HOURS=2
MAX_UPLOAD_SIZE=52428800

# --- API Security & CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com

# --- Frontend Client Configuration ---
VITE_BACKEND_URL=http://127.0.0.1:8000
